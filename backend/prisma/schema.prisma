generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          String   @id @default(cuid())
  externalId  String
  title       String
  organizer   String
  source      String
  category    String

  startsAt    DateTime
  endsAt      DateTime?
  timezone    String   @default("America/Vancouver")

  location    String
  address     String?
  imageUrl    String?
  tags        String[]
  description String
  sourceUrl   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([startsAt])
}